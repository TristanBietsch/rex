{"v":1,"cmd":"agent-help","data":{"card":1,"mode":"--agent, -o agent or REX_AGENT=1: one line per record, an ok trailer on stdout, one error line on stderr, no color, no prompts","formats":["text","txt","md","json","agent"],"exit":{"0":"ok","1":"error","2":"not_found","3":"ambiguous","4":"daemon_unreachable","5":"invalid_args","6":"refused","7":"timeout"},"kinds":["ok","error","not_found","ambiguous","daemon_unreachable","invalid_args","refused","timeout"],"selectors":"short id (4+ hex), slug or full id","commands":[{"name":"new","section":"Start & steer","args":"[flags] -- <prompt>","desc":"start an agent session","class":"action"},{"name":"attach","section":"Start & steer","args":"<sel> [flags]","desc":"open a session (ctrl+] detaches)","class":"interactive"},{"name":"reply","section":"Start & steer","args":"<sel> [flags] -- <text>","desc":"answer a session that needs input","class":"action"},{"name":"send","section":"Start & steer","args":"<sel> [flags] -- <text>","desc":"send raw input (stdin when no text)","class":"action"},{"name":"wait","section":"Start & steer","args":"<sel> [flags]","desc":"block until a session reaches a state","class":"action"},{"name":"loop","section":"Start & steer","args":"<subcommand> [args]","desc":"re-send a prompt until a check passes","class":"action"},{"name":"here","section":"Start & steer","args":"","desc":"open this workspace's board","class":"interactive"},{"name":"ls","section":"Watch","args":"[flags]","desc":"list sessions","class":"query"},{"name":"status","section":"Watch","args":"[flags]","desc":"counts; exit 1 if one needs input","class":"query"},{"name":"log","section":"Watch","args":"<sel> [flags]","desc":"print a session's transcript","class":"content"},{"name":"overview","section":"Watch","args":"[flags]","desc":"one-screen summary by bucket","class":"query"},{"name":"usage","section":"Watch","args":"[flags]","desc":"tokens, cost and plan quota","class":"query"},{"name":"digest","section":"Watch","args":"[flags]","desc":"today's sessions, time and totals","class":"query"},{"name":"stats","section":"Watch","args":"[flags]","desc":"lifetime usage by model and tool","class":"query"},{"name":"audit","section":"Watch","args":"[flags]","desc":"one line per finished session","class":"query"},{"name":"errors","section":"Watch","args":"[-n N] [-since 24h] [-clear]","desc":"failed rex commands","class":"query"},{"name":"name","section":"Manage","args":"<sel> [-clear] [-- <text>]","desc":"set, show or clear the display name","class":"action"},{"name":"rename","section":"Manage","args":"<sel> <slug>","desc":"change a session's slug","class":"action"},{"name":"done","aliases":["retire"],"section":"Manage","args":"<sel> [-after 72h]","desc":"mark done; cleared after retire_after_hours","class":"action"},{"name":"undone","aliases":["unretire"],"section":"Manage","args":"<sel>","desc":"cancel a pending done","class":"action"},{"name":"complete","section":"Manage","args":"<sel>","desc":"stop a session now and mark it done","class":"action"},{"name":"resume","section":"Manage","args":"<sel> [-print]","desc":"respawn an exited session","class":"action"},{"name":"undo","section":"Manage","args":"<sel> [-turns N] [-yes]","desc":"restore the folder to before the last turn","class":"action"},{"name":"redo","section":"Manage","args":"<sel> [-yes]","desc":"bring back what undo replaced","class":"action"},{"name":"archive","section":"Manage","args":"<sel>","desc":"archive a session","class":"action"},{"name":"rm","section":"Manage","args":"<sel> [-force]","desc":"delete a session","class":"action"},{"name":"prune","section":"Manage","args":"[-dry-run] [-yes]","desc":"delete Completed sessions","class":"action"},{"name":"fleet","section":"Manage","args":"ls|show|set|unset","desc":"list or edit session fleets","class":"query"},{"name":"export","section":"Manage","args":"<sel> [flags]","desc":"write a session as a readable document","class":"content"},{"name":"daemon","section":"Daemon","args":"start|stop|restart|status|logs","desc":"manage rex-daemon (also status, logs)","class":"action"},{"name":"reload","section":"Daemon","args":"[flags]","desc":"reload tools.yaml, config and Lua","class":"action"},{"name":"upgrade","section":"Daemon","args":"[-cold] [-yes] [flags]","desc":"hot-restart onto a newly installed build","class":"action"},{"name":"setup","section":"Setup","args":"[flags]","desc":"first-run wizard","class":"interactive"},{"name":"onboard","section":"Setup","args":"[flags]","desc":"guided tour: checks, agents, keys","class":"interactive"},{"name":"doctor","section":"Setup","args":"[flags]","desc":"check the install; exit 1 if a check fails","class":"query"},{"name":"config","section":"Setup","args":"list|get|set|reset|edit","desc":"view and change settings","class":"query"},{"name":"theme","section":"Setup","args":"list|show|new","desc":"list, inspect and create color themes","class":"query"},{"name":"trust","section":"Setup","args":"[dir] [-ls] [-rm <dir>]","desc":"trust a folder so agents skip its dialog","class":"action"},{"name":"ws","section":"Setup","args":"init|id|ls|rename|color|trust|open","desc":"workspaces (needs workspaces)","class":"action"},{"name":"skills","section":"Setup","args":"[flags]","desc":"list the skills library","class":"query"},{"name":"update","section":"Setup","args":"[flags]","desc":"upgrade rex in place","class":"action"},{"name":"uninstall","section":"Setup","args":"[flags]","desc":"remove rex and optional state","class":"action"},{"name":"completion","section":"Setup","args":"bash|zsh|fish","desc":"print a shell completion script","class":"content"},{"name":"render","section":"Setup","args":"[flags]","desc":"render an event stream from stdin","class":"content"},{"name":"version","section":"Setup","args":"","desc":"print the version","class":"query"},{"name":"agent-help","section":"Setup","args":"","desc":"the usage card for LLM agents","class":"query"}]}}
