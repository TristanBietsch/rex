# With nothing listening on the socket, daemon-backed commands exit 4
# (ExitDaemonUnreachable) and none of them starts a daemon. The harness
# fails the script if anything answers on $SOCKET when it ends.

# The dial error names the socket once (F-04: it used to be wrapped twice,
# "dial <path>: dial unix <path>: ...").
exitcode 4 rex ls
stderr '^rex: dial unix \S+/rex\.sock: connect: no such file or directory$'
! stdout .

exitcode 4 rex status
stderr 'connect: no such file or directory'
! stdout .

exitcode 4 rex status -json
! stdout .

exitcode 4 rex new -slug s1 hello
stderr 'connect: no such file or directory'

exitcode 4 rex wait s1
exitcode 4 rex rename s1 s2
exitcode 4 rex name s1
exitcode 4 rex done s1
exitcode 4 rex rm s1
exitcode 4 rex log s1

# reload talks to the socket only; it never signals a process found by name.
exitcode 4 rex reload
stderr 'rex-daemon is not running: dial unix \S+/rex\.sock: connect: no such file or directory$'

# daemon stop and status gate on the socket, not on a rex-daemon process
# found by name (the user's real daemons must not count).
exitcode 4 rex daemon stop
stderr '^rex: rex-daemon is not running: nothing answers on \S+/rex\.sock$'
! stdout .
exitcode 4 rex daemon status
stdout '^not running · socket=\S+/rex\.sock$'

# A leftover non-socket file at the socket path is unreachable too.
cp leftover $SOCKET
exitcode 4 rex ls
stderr 'connect: (connection refused|socket operation on non-socket)$'

-- leftover --
