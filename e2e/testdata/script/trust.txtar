# rex trust edits auto_trust_dirs in $HOME/.config/rex/config.yaml. No daemon
# is needed.

mkdir home/proj

# Adding a folder is for a person at a terminal: without one (here stdin and
# stdout are not terminals), in agent mode or with -o it exits 6 and writes
# nothing.
exitcode 6 rex trust $WORK/home/proj
stderr 'only at a terminal'
! exists home/.config/rex/config.yaml
exitcode 6 rex --agent trust $WORK/home/proj
exitcode 6 rex trust -o json $WORK/home/proj
! exists home/.config/rex/config.yaml

# Listed (as rex config set writes it), -ls and -rm work without a terminal.
exec rex config set auto_trust_dirs $WORK/home/proj
grep '^auto_trust_dirs: ' home/.config/rex/config.yaml
grep 'proj' home/.config/rex/config.yaml

exec rex trust -ls
stdout 'proj'

# Refusals exit 5 (before the terminal check) and leave the file alone.
exitcode 5 rex trust $WORK/home
stderr 'home folder'
exitcode 5 rex trust $WORK/home/proj/../x
stderr '\.\.'
exitcode 5 rex trust proj
stderr 'absolute'
exitcode 5 rex trust -ls -rm $WORK/home/proj
exitcode 5 rex new -trust -cwd $WORK/home -- hi
stderr 'home folder'

exec rex trust -rm $WORK/home/proj
exec rex config get auto_trust_dirs
! stdout 'proj'
