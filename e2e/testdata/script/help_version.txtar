# Top-level help and version need no daemon and exit 0.

exec rex help
stdout 'USAGE'
stdout 'rex <command> \[flags\]'
stdout 'completion <shell>'
! stderr .

exec rex --help
stdout 'USAGE'

exec rex -h
stdout 'USAGE'

exec rex version
stdout '^v1$'
! stderr .

exec rex --version
stdout '^v1$'

exec rex -v
stdout '^v1$'

exec rex-daemon -version
stdout '^v1$'

# An unknown verb is invalid args; a near miss names the real command.
exitcode 5 rex frobnicate
stderr '^rex: unknown command "frobnicate" \(try `rex --help`\)$'
exitcode 5 rex lss
stderr 'did you mean "ls"\?'

# -h on a subcommand prints its usage and exits 0, with no error line.
exec rex ls -h
stderr 'Usage of ls:'
! stderr '^rex:'

exec rex new -h
stderr 'Usage of new:'
! stderr '^rex:'

exec rex wait p1 -h
stderr 'Usage of wait:'
! stderr '^rex:'
