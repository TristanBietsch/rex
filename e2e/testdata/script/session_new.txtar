# Spawn echo sessions, then read them back with ls and status.

daemon-start

# Flags may follow the prompt.
exec rex new x --tool echo --model short --slug s1
stdout '^[0-9a-f]{4}\ts1$'

# Text that starts with - goes after --; the slug is derived from it.
exec rex new --tool echo --model short -- -tool echo model short slug text
stdout '^[0-9a-f]{4}\ttool-echo-model-short-slug-text$'

# An unknown flag after the text is an error with a hint.
exitcode 5 rex new fix the -bogus thing
stderr 'use -- before text that starts with -'

# An explicit slug that is taken is rejected by the daemon.
exitcode 5 rex new --tool echo --model short --slug s1 again
stderr '^rex: spawn failed: slug "s1" already in use by [0-9a-f]{4}$'

exec rex ls
stdout '^ID +STATE +TOOL +MODEL +SLUG +LAST EVENT +NAME$'
stdout '^[0-9a-f]{4} +\w+ +echo +short +s1 '
# The table cuts slugs to 24 columns.
stdout ' tool-echo-model-short-s… '

exec rex ls -json
stdout '"slug":"s1"'
stdout '"tool_id":"echo"'
stdout '"model_id":"short"'

exec rex wait -until done -timeout 20s s1
exec rex wait -until done -timeout 20s tool-echo-model-short-slug-text

exec rex status
stdout '^0 awaiting input · 0 working · 2 completed$'

exec rex status -json
stdout '"completed":2'
stdout '"working":0'

exec rex ls -state done
stdout ' s1 '
exec rex ls -state working
stdout '^\(no sessions\)$'

# status trusts the socket. The PID is display only: it reads "unknown"
# when other rex-daemon processes (the developer's own) also exist.
exec rex daemon status
stdout '^running · socket=\S+/rex\.sock · pid=(\d+|unknown)$'

daemon-stop

-- home/.config/rex/config.yaml --
summary_enabled: false
model_autodetect: false
